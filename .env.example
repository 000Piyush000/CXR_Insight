# Copy this file to .env and fill in the values you have.
# The app runs fully in DEMO MODE with none of these set.

# Hugging Face token, needed to download gated models such as
# meta-llama/Meta-Llama-3.1-8B-Instruct
HF_TOKEN=

# Path to your fine-tuned Swin-T5 CXR report-generation checkpoint.
# Leave blank to use the built-in template-based fallback report generator.
SWIN_T5_CHECKPOINT=

# Which LLaMA checkpoint to load for the chat assistant.
LLM_MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct

# Set to "cpu", "cuda", or leave blank for auto-detect.
DEVICE=

# Set to "1" to force the lightweight rule-based fallbacks even if
# transformers/torch and the real weights are available (useful for a
# fast demo on a laptop with no GPU).
FORCE_DEMO_MODE=0

# Flask
FLASK_SECRET_KEY=change-me
FLASK_PORT=5000
